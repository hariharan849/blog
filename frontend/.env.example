# Public URL of this site (share links, RSS, metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Daily Dose backend (outputs of `sam deploy` in /backend) ---
# ApiUrl output, no trailing slash.
FEED_API_URL=
# Same value as the SSM SecureString /dailydose/admin-token. Server-side only.
FEED_ADMIN_TOKEN=
# Same value as the SSM SecureString /dailydose/revalidate-secret.
REVALIDATE_SECRET=

# --- Admin sign-in (GitHub OAuth app, callback: <site>/api/auth/callback/github) ---
GITHUB_ID=
GITHUB_SECRET=
# Comma-separated GitHub usernames allowed into /admin.
ADMIN_GITHUB_LOGINS=hariharan849
# Random string: `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
