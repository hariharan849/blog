# Copy to .env for local development. Never commit real secrets.
DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOST=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DATABASE_URL=postgres://user:password@localhost:5432/blog

# --- AI search ---
# Offline default (word-overlap vectors, no API key):
AI_SEARCH_EMBEDDER=blog.search.embeddings.HashingEmbedder
# Real semantic search with Voyage AI:
# AI_SEARCH_EMBEDDER=blog.search.embeddings.VoyageEmbedder
# AI_SEARCH_EMBEDDING_MODEL=voyage-3.5
# AI_SEARCH_EMBEDDING_API_KEY=...
# Or any OpenAI-compatible /v1/embeddings server (OpenAI, Ollama, vLLM, ...):
# AI_SEARCH_EMBEDDER=blog.search.embeddings.OpenAICompatibleEmbedder
# AI_SEARCH_EMBEDDING_API_BASE=http://localhost:11434/v1
# AI_SEARCH_EMBEDDING_MODEL=nomic-embed-text
# AI_SEARCH_EMBEDDING_API_KEY=ollama
# AI_SEARCH_DEFAULT_MODE=hybrid
# AI_SEARCH_AUTO_INDEX=True

# --- Daily Bytes (private learning digest at /bytes/) ---
# Without a key, articles are tagged with a keyword fallback.
# ANTHROPIC_API_KEY=...
# DAILY_BYTES_MODEL=claude-opus-5-5   # ~$0.50-1/day for ~30 articles; claude-haiku-5-5 is ~2 cents/day
# DAILY_BYTES_EFFORT=low
# DAILY_BYTES_MAX_ENRICH_PER_RUN=40
# DAILY_BYTES_MAX_ARTICLE_AGE_DAYS=3
# DAILY_BYTES_DIGEST_SIZE=8
# DAILY_BYTES_MAX_PER_SOURCE=2
# DAILY_BYTES_MIN_RELEVANCE=50
# DAILY_BYTES_FETCH_FULL_TEXT=False   # fetch public article pages (robots.txt permitting) when feeds only have excerpts
# DAILY_BYTES_EMAIL_TO=you@example.com
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# DEFAULT_FROM_EMAIL=bytes@example.com
